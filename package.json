{
  "name": "geripaws",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "web": "pnpm --filter geripaws-app web",
    "ios": "pnpm --filter geripaws-app ios",
    "test": "vitest run",
